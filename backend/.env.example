# ===== 运行环境 =====
APP_NAME=contract-review
APP_ENV=dev
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===== 数据库 =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=contract
MYSQL_PASSWORD=change-me
MYSQL_DB=contract_review
# 本地无 MySQL 时可设为 sqlite:///./data/contract_review.db
DATABASE_URL=

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Windows 本地开发无 Redis 时可设为 true（需要 dev 依赖中的 fakeredis）
REDIS_FAKE=false

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== DeepSeek（推理） =====
# TODO：只需填写 DeepSeek API Key
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_REVIEW_MODEL=deepseek-flash
LLM_CHAT_MODEL=deepseek-flash
LLM_INTENT_MODEL=deepseek-flash
# 仅允许这些推理模型，防止误用昂贵模型；切换中转模型ID时同步修改
LLM_ALLOWED_MODELS=deepseek-flash

# ===== 阿里云百炼（Embedding / Rerank） =====
# TODO：同一个百炼 API Key 可同时填写到下面两项
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank

# ===== Qdrant =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
# 本地无 Qdrant 服务时可填写持久化目录，如 ./data/qdrant_local
QDRANT_LOCATION=
QDRANT_COLLECTION_REGULATIONS=kb_regulations
QDRANT_COLLECTION_INSTITUTION=kb_institution
QDRANT_COLLECTION_TEMPLATES=kb_templates

# ===== RAG 检索参数 =====
RAG_HYBRID_TOP_K=60
RAG_RERANK_TOP_K=5
RAG_QUERY_VARIANTS=3
RAG_QUERY_EXPANSION_TIMEOUT=15
RAG_PER_DOC_QUOTA=3
RAG_EVIDENCE_RERANK_ENABLED=true
RAG_EVIDENCE_RERANK_DOCS=30
RAG_EVIDENCE_RERANK_TIMEOUT=20
RAG_CONTEXT_MAX_CHARS=7000

# ===== Langfuse（自托管） =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ===== 文件存储 =====
UPLOAD_DIR=/data/uploads
OSS_BUCKET_DIR=/data/parsed
# 阿里云 OSS：填写下列配置后再将 STORAGE_BACKEND 改成 oss
STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_PREFIX=contract-review

# ===== 文档 OCR =====
# OCR_API_KEY 留空时复用 EMBEDDING_API_KEY；cloud_ocr 需显式加入引擎列表
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=
OCR_MODEL=qwen3.5-ocr
OCR_MAX_PAGES=10
DOC_PARSER_ENGINES=pdfplumber,pymupdf,pypdf,docx,libreoffice,ocr

# ===== 前端 / CAS =====
FRONTEND_URL=http://localhost:5173
CAS_SERVER_URL=

# ===== LLM 并发与缓存 =====
LLM_PROMPT_CACHE=false
# 默认为true，沿用环境及Windows系统代理；本机代理不可用时可设为false直连
LLM_HTTP_TRUST_ENV=true
# DeepSeek兼容中转支持thinking参数时可显式开启；留空按官网地址自动判断
# LLM_BRIEF_DISABLE_THINKING=true
# 兼容中转的短任务参数须实测；本轮Flash路线验证为low
# LLM_BRIEF_REASONING_EFFORT=low
MAX_CONCURRENT_LLM=4
AGENT_REVIEW_MAX_TOKENS=4096
AGENT_EVIDENCE_AUDIT_ENABLED=true
AGENT_EVIDENCE_AUDIT_TIMEOUT=90
